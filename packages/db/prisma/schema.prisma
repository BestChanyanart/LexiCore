generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id          String   @id
  title       String
  code        String?
  description String
  modules     Module[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Module {
  id          String   @id
  courseId    String
  title       String
  description String?
  course      Course   @relation(fields: [courseId], references: [id])
  questions   Question[]
}

model Statute {
  id        String   @id
  courseId  String
  moduleId  String
  title     String
  tags      String[]
  createdAt DateTime @default(now())
}

model Question {
  id        String   @id
  courseId  String
  moduleId  String
  level     Int
  type      String
  title     String
  scenario  String
  prompt    String
  rubricId  String?
  module    Module   @relation(fields: [moduleId], references: [id])
}

